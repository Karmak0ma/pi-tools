{
  "name": "sidebar-vflo",
  "version": "0.1.0",
  "description": "A configurable Pi sidebar without replacing the footer",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "sidebar"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.7",
    "@earendil-works/pi-tui": ">=0.80.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
