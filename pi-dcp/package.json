{
  "name": "pi-dcp",
  "version": "0.1.0",
  "description": "Non-destructive dynamic context pruning for Pi",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "keywords": ["pi-package", "pi-extension", "context", "compression"],
  "license": "AGPL-3.0-or-later",
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.1",
    "@earendil-works/pi-agent-core": ">=0.84.1",
    "@earendil-works/pi-ai": ">=0.84.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@types/node": "24.12.4",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:property": "vitest run test/property",
    "test:golden": "vitest run test/golden",
    "test:integration": "vitest run test/integration",
    "test:crash": "vitest run test/crash",
    "test:security": "vitest run test/security",
    "test:performance": "vitest run test/performance",
    "check": "npm run typecheck && npm run test:unit && npm run test:property && npm run test:golden && npm run test:integration && npm run test:crash && npm run test:security && npm run test:performance",
    "test:live:opencode": "vitest run test/integration --config vitest.config.ts -t live:opencode",
    "test:live:openai": "vitest run test/integration --config vitest.config.ts -t live:openai"
  }
}
